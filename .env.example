# Copy values into your environment; never commit real secrets.
NODE_ENV=development
LEXORA_HOST=127.0.0.1
LEXORA_PORT=3000
LEXORA_DATA_DIR=./data

# Server-side AI credentials. Keep these out of the frontend and source control.
GEMINI_API_KEY=
GEMINI_MODEL=
AI_TIMEOUT_MS=20000
GEMINI_INPUT_USD_PER_MILLION=
GEMINI_OUTPUT_USD_PER_MILLION=
# Optional model cache directory; defaults to data/model-cache.
LEXORA_ML_CACHE_DIR=

# Optional. Use a long, random value and provision it through a secret manager.
# The first account registered with this token becomes the sole bootstrap admin.
LEXORA_ADMIN_BOOTSTRAP_TOKEN=

# Public self-registration is intended only for a local demonstration.
# Production deployments should set this to false and use an approved identity flow.
LEXORA_ALLOW_SIGNUP=true
